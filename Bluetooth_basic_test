void setup() {

// start serial communication (115200 = baud rate) 
Serial.begin(115200); 

SerialBT.begin("RUNNER"); 

Serial.println("Bluetooth started"); 

}

void loop() {

// check if data is waiting 
if (SerialBT.available()) {

// read command and store in command 
string command = SerialBT.readStringUntil('\n'); 

// print for serial monitor 
Serial.print("Received: ");
Serial.println(command);

// print for bluetooth
SerialBT.print("Received: ");
SerialBT.println(command);

// rough commands 

if (command == 'MOVE') {
Serial.println("Command: MOVE");

// to do: add robot movements 
}

else if (command == 'STOP') {
Serial.println("Command: STOP");

// to do:  stop all motors 
}

else if (command == 'STATUS') {
Serial.println("Command: STATUS");

// to do : return status of the robot 
}

else {
Serial.println("Command: INVALID"); 
}


}
} 
